# ---- LaTeX compilation artifacts ----
# Core
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.dvi
*.xdv
*.synctex
*.synctex.gz
*.synctex(busy)
*.auxlock

# Bibliography (BibTeX / biber)
*.bbl
*.blg
*.bcf
*.run.xml
*-blx.bib

# Beamer
*.nav
*.snm
*.vrb

# Indexes, glossaries, nomenclature
*.idx
*.ilg
*.ind
*.glo
*.gls
*.glg
*.acn
*.acr
*.alg
*.ist
*.nlo
*.nls

# Package outputs (listings, minted, svg, theorems)
*.lol
*.loa
*.thm
*.brf
*.spl
_minted*/
*.pyg
svg-inkscape/

# Compiled paper (figure PDFs in assets/ are still tracked)
docs/LaTeX_paper/main.pdf

# ---- Apps (android/ and dashboard/ also have their own .gitignore) ----
# Node (dashboard, backend)
node_modules/
dist/
coverage/
*.tsbuildinfo
.eslintcache
npm-debug.log*

# Secrets: database passwords, API keys (commit a .env.example instead)
.env
.env.*
!.env.example

# OS and editor files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TrackSeed track plan",
  "description": "A Formula Student track as a list of cones. Positions are in metres in the track's local frame: origin at marker A, x east, y north.",
  "type": "object",
  "required": ["name", "type", "cones"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S" },
    "type": { "enum": ["skidpad", "acceleration", "autocross", "trackdrive"] },
    "cones": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": {
        "type": "object",
        "required": ["x", "y", "colour"],
        "additionalProperties": false,
        "properties": {
          "x": { "type": "number", "minimum": -5000, "maximum": 5000 },
          "y": { "type": "number", "minimum": -5000, "maximum": 5000 },
          "colour": {
            "description": "orange is the small orange cone; big_orange the large one at start, finish and timing lines.",
            "enum": ["blue", "yellow", "orange", "big_orange"]
          }
        }
      }
    }
  }
}
